{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vesper",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "medium",
    "image_preview": false
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "single": false
  },
  "prompt": {
    "paste": "compact"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.20000000000000004
  },
  "terminal": {
    "title": true
  }
}
